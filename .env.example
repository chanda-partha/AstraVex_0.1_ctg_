# NASA Mission Explorer - Environment Configuration

# Server Port
PORT=5000

# Optional Official NASA API Key (Defaults to NASA DEMO_KEY if blank)
NASA_API_KEY=DEMO_KEY

# Optional Gemini LLM API Key (Get your key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional CORS Allowed Origins (Comma-separated or '*' for all; defaults to permitting all if blank)
# CORS_ALLOWED_ORIGIN=https://astravex.onrender.com,https://astravex.vercel.app

