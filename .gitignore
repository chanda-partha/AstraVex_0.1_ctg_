# ============================================================
# NASA Mission Explorer — .gitignore
# ============================================================

# Dependencies (NEVER commit these — reinstall with npm install)
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Build outputs
dist/
build/
client/dist/
client/build/

# Environment variables (KEEP SECRET — never push API keys!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# TypeScript cache
*.tsbuildinfo

# Vite cache
.vite/
**/.vite/

# Coverage
coverage/
*.lcov

# Testing
test-results/
playwright-report/

# Temp files
*.tmp
*.temp
tmp/

# Package manager lock files (keep package-lock.json but ignore others)
yarn.lock
pnpm-lock.yaml
